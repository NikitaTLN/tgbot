# Telegram bot token from @BotFather
BOT_TOKEN=your_telegram_bot_token_here

# OnlyDrafts.racing login credentials
OD_EMAIL=your_email_or_login
OD_PASSWORD=your_password

# Telegram chat/channel ID to send race notifications to
# Find it by adding the bot to the channel and checking logs
CHAT_ID=

# Polling interval in seconds (how often to check for new races)
POLL_INTERVAL=60
